# ==============================================================================
# POSTFLOW ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development Mock Mode (Simulates Instagram, Facebook, and YouTube without live APIs)
# Set to 'true' for local testing and demonstration. Set to 'false' in production.
SOCIAL_API_MOCK_MODE=true
NEXT_PUBLIC_SOCIAL_API_MOCK_MODE=true

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# Obtain from your Supabase Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Server-only service_role key (NEVER expose to client browser!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# TOKEN ENCRYPTION SECURITY
# 32-byte secret key (or passphrase) used for AES-256-GCM token encryption at rest
# Generate on Linux/Mac: openssl rand -hex 32
# ------------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b

# ------------------------------------------------------------------------------
# META DEVELOPER APP (Instagram Graph API & Facebook Page API)
# Obtain from developers.facebook.com -> App Dashboard
# Required Permissions: pages_show_list, pages_read_engagement, pages_manage_posts, instagram_basic, instagram_content_publish
# ------------------------------------------------------------------------------
META_APP_ID=123456789012345
META_APP_SECRET=abcdef0123456789abcdef0123456789
META_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback

# ------------------------------------------------------------------------------
# GOOGLE CLOUD CONSOLE (YouTube Data API v3 & Google OAuth)
# Obtain from console.cloud.google.com -> Credentials -> OAuth 2.0 Client IDs
# Authorized Redirect URI: http://localhost:3000/api/auth/youtube/callback
# (In production: https://YOUR-DOMAIN.com/api/auth/youtube/callback)
# Required Scopes: openid, email, profile, https://www.googleapis.com/auth/youtube.upload
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-abcdefghijklmnopqrstuvwxyz
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback


# ------------------------------------------------------------------------------
# BACKGROUND SCHEDULER & CRON SECURITY
# Optional secret header for authenticating Vercel Cron or webhook calls to /api/cron/publish
# ------------------------------------------------------------------------------
CRON_SECRET=super_secret_cron_token_change_me
